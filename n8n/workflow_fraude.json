    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst items = $input.all();\n\nconst firstItem = items[0].json;\nconst body = firstItem.body || firstItem;\nconst type_investigation = body.type_investigation || 'complete';\nconst email = body.email || 'professeur@ensaj.ma';\nconst exam_question = body.exam_question || '';\nconst investigation_id = body.investigation_id || Date.now().toString();\nconst callback_url = body.callback_url || 'http://127.0.0.1:5001/api/investigation/callback';\n\nconst UPLOAD_DIR = path.join('C:\\\\Forensic_Storage\\\\investigations', investigation_id);\nif (!fs.existsSync(UPLOAD_DIR)) fs.mkdirSync(UPLOAD_DIR, { recursive: true });\n\nconst fichiersSauvegardes = [];\nfor (const item of items) {\n  const files = item.binary || {};\n  for (const [key, file] of Object.entries(files)) {\n    const nomFichier = file.fileName || `scan_${Date.now()}_${Math.random().toString(36).substring(7)}.jpg`;\n    const cheminSortie = path.join(UPLOAD_DIR, nomFichier);\n    const buffer = Buffer.from(file.data, 'base64');\n    fs.writeFileSync(cheminSortie, buffer);\n    fichiersSauvegardes.push({ nom: nomFichier, chemin: cheminSortie });\n  }\n}\nreturn [{ json: { fichiers: fichiersSauvegardes, nb_fichiers: fichiersSauvegardes.length, type_investigation: type_investigation, exam_question: exam_question, email: email, investigation_id: investigation_id, callback_url: callback_url } }];"
      },
