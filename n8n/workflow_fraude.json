        "command": "=cd C:\\Users\\HP\\Downloads\\prjt_fixed2 && env\\Scripts\\python.exe logic_crewai\\ocr_batch.py --dossier \"C:/Forensic_Storage/investigations/{{$node.SauvegardeImages.json.investigation_id}}\" --sortie \"C:/Forensic_Storage/investigations/{{$node.SauvegardeImages.json.investigation_id}}/resultats_ocr.json\" --question \"{{$node.SauvegardeImages.json.exam_question}}\" 2>&1"
