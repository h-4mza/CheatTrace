    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '{}';\nlet resultat = null;\n\nconst beginMarker = '===BEGIN_N8N_JSON===';\nconst endMarker = '===END_N8N_JSON===';\nconst startIndex = stdout.indexOf(beginMarker);\nconst endIndex = stdout.lastIndexOf(endMarker);\n\nif (startIndex !== -1 && endIndex !== -1 && endIndex > startIndex) {\n  const jsonStr = stdout.substring(startIndex + beginMarker.length, endIndex).trim();\n  try {\n    resultat = JSON.parse(jsonStr);\n  } catch (e) { }\n}\n\nif (!resultat) resultat = { statut: 'erreur_parsing', raw: stdout.substring(0, 1000) };\nreturn [{ json: resultat }];"
      },
